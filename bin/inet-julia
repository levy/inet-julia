#!/bin/sh
#
# The developer wrapper. Runs the same entry point the built executable runs,
# through the checkout instead of through an image, so a change can be tried
# without a build:
#
#     bin/inet-julia -f omnetpp.ini -c TestNetwork -r 0
#
# The built executable is what a user gets. Make it with:
#
#     julia --project=tool tool/build_binary.jl
#
root=$(cd "$(dirname "$0")/.." && pwd)
project="$root/package/runner/main"

# A Manifest is gitignored, so a fresh checkout has none and the run would fail
# on the first `using`. Resolve once, and say so, because it is slow and the
# next run is not.
if [ ! -f "$project/Manifest.toml" ]; then
    echo "inet-julia: resolving $project (once)" >&2
    julia --project="$project" -e 'using Pkg; Pkg.instantiate()' >&2 || exit 2
fi

exec julia --project="$project" \
     -e 'using InetRunner; exit(InetRunner.julia_main())' -- "$@"
